Screen {
    background: $surface;
}

#body {
    height: 1fr;
}

#sidebar {
    width: 22;
    background: $panel;
    border-right: solid $primary;
    padding: 1;
}

#sidebar Button {
    width: 100%;
    margin-bottom: 1;
}

#content {
    height: 1fr;
    padding: 1 2;
}

.panel-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

.section {
    text-style: bold;
    margin-top: 1;
}

.row {
    height: auto;
}

.row > Vertical {
    width: 1fr;
    margin-right: 1;
}

.range-in {
    width: 1fr;
    margin-right: 1;
}

Input {
    margin-bottom: 1;
}

.status {
    margin-top: 1;
    height: auto;
}

#res-table {
    height: auto;
    margin: 1 0;
}

#opt-progress {
    margin: 1 0;
}

.strategy-card {
    border: round $primary;
    padding: 1;
    margin-bottom: 1;
}
